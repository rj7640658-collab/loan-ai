# ==============================================================
# AI Loan Eligibility Checker & BFSI Platform Configuration
# ==============================================================

# Flask Server Config
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=bfsi-loan-ai-secret-key-super-secure-2026

# Groq API Configuration (Fast Inference for Llama-3.3-70b-versatile)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Claude AI (Anthropic) Configuration
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Preferred AI Provider ('groq' or 'claude' or 'auto')
AI_PROVIDER=auto

# Google Apps Script Web App Endpoint for Google Sheets Logging
# Paste your deployed Google Apps Script Web App URL here:
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
